DB_HOST=
DB_PORT=
DB_USERNAME=
DB_PASSWORD=
DB_NAME=
MONGODB_URI=

AI_TOKEN=

# Ordered, comma-separated 9Router chat models for grounded course answers.
# The timeout is shared across configured models for each request.
NINEROUTER_CHAT_MODEL=
NINEROUTER_CHAT_TIMEOUT_SECONDS=120
# Ordered, comma-separated 9Router chat models for lesson summaries.
# The timeout is shared across configured models for each request.
NINEROUTER_SUMMARY_MODEL=
NINEROUTER_SUMMARY_TIMEOUT_SECONDS=120
SUMMARY_CHUNK_SIZE=
SUMMARY_MAX_OUTPUT_TOKENS=

# Self-hosted 9Router OpenAI-compatible transcription endpoint.
NINEROUTER_URL=
NINEROUTER_API_KEY=
# Ordered, comma-separated 9Router transcription models.
# NINEROUTER_TIMEOUT_SECONDS is shared across configured models per request.
NINEROUTER_STT_MODEL=
NINEROUTER_LANGUAGE=vi
NINEROUTER_TIMEOUT_SECONDS=1500
TRANSCRIBE_MAX_BYTES=
TRANSCRIBE_DOWNLOAD_TIMEOUT_SECONDS=
TRANSCRIBE_ALLOWED_HOSTS=

# Dropout-risk model artifacts in MinIO.
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change-me-strong-password
MINIO_BUCKET_AI_MODELS=ai-models
MINIO_SECURE=false
DROPOUT_MODEL_CACHE_DIR=/var/cache/ai-models
