DB_HOST=
DB_PORT=
DB_USERNAME=
DB_PASSWORD=
DB_NAME=
MONGODB_URI=

AI_TOKEN=
LLM_PROVIDER=
GEMINI_API_KEY=
GEMINI_MODEL=
GEMINI_TIMEOUT_SECONDS=

# Lesson summary: Gemini output is required. Failures are retried by the backend;
# raw or extractive transcript text is never stored as a completed summary.
SUMMARY_PROVIDER=
SUMMARY_CHUNK_SIZE=
SUMMARY_MAX_OUTPUT_TOKENS=

# faster-whisper downloads the selected model on first use.
WHISPER_MODEL=
WHISPER_DEVICE=
WHISPER_COMPUTE_TYPE=
WHISPER_LANGUAGE=
WHISPER_DOWNLOAD_ROOT=
TRANSCRIBE_MAX_BYTES=
TRANSCRIBE_DOWNLOAD_TIMEOUT_SECONDS=
TRANSCRIBE_ALLOWED_HOSTS=

# Dropout-risk model artifacts in MinIO.
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change-me-strong-password
MINIO_BUCKET_AI_MODELS=ai-models
MINIO_SECURE=false
DROPOUT_MODEL_CACHE_DIR=/var/cache/ai-models